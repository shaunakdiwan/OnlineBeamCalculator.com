---
import Layout from '../../layouts/Layout.astro';
import { PRESETS, VARIANT_LANDINGS } from '../../lib/ui/presets';
---

<Layout
  title="Online Beam Calculator | SFD, BMD & Deflection"
  description="Free online beam calculator: analyze simply supported, cantilever, and continuous beams with instant SFD, BMD and deflection diagrams."
  keywords={['online beam calculator', 'beam calculator online', 'free beam calculator', 'beam calculator free']}
>
  <div class="mx-auto max-w-7xl px-md sm:px-lg py-lg">
    <h1 class="text-display-md font-semibold mb-md">Online beam calculator</h1>
    <div id="beam-app" class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-lg">
      <aside id="input-panel" class="card p-md min-w-0 overflow-x-auto"></aside>
      <section class="flex flex-col gap-lg min-w-0">
        <div id="beam-canvas-wrap" class="card p-md overflow-x-auto"></div>
        <div id="results-dashboard"></div>
        <div id="diagrams" class="flex flex-col gap-lg"></div>
      </section>
    </div>

    <div class="mt-5xl max-w-[48rem] text-body-md text-body space-y-xl">
      <section>
        <h2 class="text-display-md font-semibold text-ink">Every beam case, one directory</h2>
        <p class="mt-sm">
          The tool above starts blank. If your problem matches a standard configuration, the
          calculators below load it pre-configured: just swap in your span, loads and section.
          All of them are the same free tool running in your browser, with the same reactions,
          shear force and bending moment diagrams, slope, deflection curves and stress checks.
        </p>
      </section>

      <section>
        <h2 class="text-display-sm font-semibold text-ink">Calculators by beam type</h2>
        <ul class="mt-sm grid gap-xxs sm:grid-cols-2 text-body-sm">
          {VARIANT_LANDINGS.map((v) => (
            <li><a class="text-link hover:underline" href={`/calculator/${v.slug}`}>{v.h1}</a></li>
          ))}
          <li><a class="text-link hover:underline" href="/calculator/fixed-fixed-udl">Fixed–fixed beam, UDL</a></li>
          <li><a class="text-link hover:underline" href="/calculator/overhanging-beam">Overhanging beam</a></li>
          <li><a class="text-link hover:underline" href="/calculator/continuous-two-span">Continuous beam, two spans</a></li>
          <li><a class="text-link hover:underline" href="/calculator/gerber-hinge">Gerber beam with internal hinge</a></li>
        </ul>
      </section>

      <section>
        <h2 class="text-display-sm font-semibold text-ink">Worked examples</h2>
        <p class="mt-xs text-body-sm">
          Standard textbook cases, ready to run and compare against the closed-form answers on the
          <a class="text-link hover:underline" href="/formulas"> beam formulas</a> page.
        </p>
        <ul class="mt-sm grid gap-xxs sm:grid-cols-2 text-body-sm">
          {PRESETS.map((p) => (
            <li><a class="text-link hover:underline" href={`/calculator/${p.slug}`}>{p.name}</a></li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="text-display-sm font-semibold text-ink">Which calculator do I need?</h2>
        <p class="mt-xs text-body-sm">
          For floor and roof framing in timber, start with the
          <a class="text-link hover:underline" href="/calculator/wood-beam-calculator"> wood beam calculator</a>.
          For structural steel with AISC W-shapes, use the
          <a class="text-link hover:underline" href="/calculator/steel-beam-calculator"> steel beam calculator</a>.
          For rafters bearing on a structural ridge, the
          <a class="text-link hover:underline" href="/calculator/ridge-beam-calculator"> ridge beam calculator</a>
          models rafter reactions as point loads. For beams running over three or more supports,
          start from the <a class="text-link hover:underline" href="/calculator/continuous-two-span">continuous two-span</a>
          example. Background reading: the <a class="text-link hover:underline" href="/guide">SFD &amp; BMD guide</a>
          explains how to read the output, and the <a class="text-link hover:underline" href="/about">about page</a>
          covers the tool's assumptions and limitations.
        </p>
      </section>
    </div>
  </div>
  <script>
    import { initBeamApp } from '../../lib/ui/app';
    initBeamApp();
  </script>
</Layout>
