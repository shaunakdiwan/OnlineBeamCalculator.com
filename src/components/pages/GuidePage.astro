---
/**
 * Shared GuidePage component — renders the guide page for any locale.
 */

import type { GuideCopy } from '../../i18n/types';

interface Props {
  locale: string;
  copy: GuideCopy;
}

const { locale, copy } = Astro.props;
---

<div class="mx-auto max-w-[48rem] px-lg py-xl">
  <div class="eyebrow uppercase mb-xxs">{copy.eyebrow}</div>
  <h1 class="text-display-lg font-semibold">{copy.h1}</h1>

  <div class="mt-lg space-y-xl text-body-md text-body">
    <section>
      <h2 class="text-display-sm font-semibold text-ink mb-sm">{copy.sfd.h2}</h2>
      <p>{copy.sfd.p}</p>
    </section>
    <section>
      <h2 class="text-display-sm font-semibold text-ink mb-sm">{copy.bmd.h2}</h2>
      <p>{copy.bmd.p}</p>
    </section>
    <section id="sign-conventions">
      <h2 class="text-display-sm font-semibold text-ink mb-sm">{copy.signs.h2}</h2>
      <p set:html={copy.signs.p} />
    </section>
    <section>
      <h2 class="text-display-sm font-semibold text-ink mb-sm">{copy.supports.h2}</h2>
      <ul class="list-disc pl-md space-y-xxs">
        {copy.supports.items.map((item, i) => (
          <li key={i} set:html={item} />
        ))}
      </ul>
    </section>
    <section>
      <h2 class="text-display-sm font-semibold text-ink mb-sm">{copy.method.h2}</h2>
      <p>{copy.method.p}</p>
    </section>
    <section>
      <h2 class="text-display-sm font-semibold text-ink mb-sm">{copy.tryIt.h2}</h2>
      <p set:html={copy.tryIt.p} />
    </section>
    <section>
      <h2 class="text-display-sm font-semibold text-ink mb-sm">{copy.stresses.h2}</h2>
      <p>{copy.stresses.p}</p>
    </section>
  </div>
</div>