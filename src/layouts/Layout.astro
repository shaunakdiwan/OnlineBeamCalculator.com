---
import '../styles/global.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = 'Beam Calculator — Free Online Shear, Moment & Deflection Diagrams',
  description = 'Free online beam calculator for simply supported, cantilever, fixed, overhanging and continuous beams. Instant shear force, bending moment & deflection diagrams. No signup, no limits.',
  canonical,
  ogImage,
  ogType = 'website',
  keywords,
  jsonLd,
  noindex = false,
} = Astro.props;

const site = 'https://onlinebeamcalculator.com';
const siteName = 'OnlineBeamCalculator.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
const ogImageUrl = ogImage ?? `${site}/og.png`;

const primaryKeywords = [
  'beam calculator',
  'free beam calculator',
  'online beam calculator',
  'beam calculator online',
  'steel beam calculator',
  'wood beam calculator',
  'cantilever beam calculator',
  'simply supported beam calculator',
  'ridge beam calculator',
  'simple beam calculator',
];
const keywordsStr = (keywords ?? primaryKeywords).join(', ');

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Online Beam Calculator',
  alternateName: ['Beam Calculator', 'Free Beam Calculator', 'Online Beam Calculator'],
  url: site,
  applicationCategory: 'EngineeringApplication',
  applicationSubCategory: 'Structural Analysis',
  operatingSystem: 'Any',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Simply supported, cantilever, fixed, overhanging, and continuous beam analysis',
    'Shear force (SFD) and bending moment (BMD) diagrams',
    'Slope and deflection calculations',
    'Spring supports and internal hinges',
    'Point, moment, uniform, triangular and trapezoidal loads',
    'Self-weight and support settlement',
    'Metric and imperial units',
    'CSV export and printable PDF reports',
  ],
  description,
  audience: { '@type': 'Audience', audienceType: 'Engineers, students, builders' },
  provider: { '@type': 'Organization', name: siteName, url: site },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordsStr} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="author" content={siteName} />
    <meta name="theme-color" content="#171717" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L9C6S6PT5K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-L9C6S6PT5K');
    </script>

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="OnlineBeamCalculator" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Online Beam Calculator: free shear, moment and deflection diagrams" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      // theme boot before first paint (avoid FOUC)
      try {
        const t = localStorage.getItem('obc:theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch {}
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppLd)} />
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-canvas-soft text-ink font-sans">
    <header class="sticky top-0 z-40 bg-canvas border-b border-hairline">
      <nav class="mx-auto max-w-7xl px-md sm:px-lg min-h-16 py-xs flex flex-wrap items-center justify-between gap-xs" aria-label="Main">
        <a href="/" class="flex items-center gap-xs font-semibold tracking-tight text-body-sm sm:text-body-md">
          <img src="/Website_logo-circle.png" alt="" width="28" height="28" class="h-7 w-7 rounded-full" />
          <span>OnlineBeamCalculator<span class="text-link">.com</span></span>
        </a>
        <div class="hidden md:flex items-center gap-xxs text-body-sm">
          <a class="px-sm py-xs rounded-full text-body hover:text-ink" href="/calculator">Calculator</a>
          <a class="px-sm py-xs rounded-full text-body hover:text-ink" href="/formulas">Formulas</a>
          <a class="px-sm py-xs rounded-full text-body hover:text-ink" href="/guide">Guide</a>
          <a class="px-sm py-xs rounded-full text-body hover:text-ink" href="/#faq">FAQ</a>
          <a class="px-sm py-xs rounded-full text-body hover:text-ink" href="/about">About</a>
        </div>
        <div class="flex items-center gap-sm">
          <button id="theme-toggle" class="btn-secondary h-7 px-xs rounded-sm text-body-sm" aria-label="Toggle dark mode" title="Toggle dark mode">◐</button>
          <span class="eyebrow hidden sm:inline border border-hairline rounded-full px-xs py-[2px] bg-canvas-soft">100% FREE</span>
          <a href="/calculator" class="btn-primary h-7 px-xs rounded-sm text-body-sm">Open calculator</a>
        </div>
      </nav>
      <script is:inline>
        (() => {
          const b = document.getElementById('theme-toggle');
          b?.addEventListener('click', () => {
            const dark = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('obc:theme', dark ? 'dark' : 'light'); } catch {}
            window.dispatchEvent(new CustomEvent('obc:theme', { detail: { dark } }));
          });
        })();
      </script>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-canvas border-t border-hairline mt-4xl">
      <div class="mx-auto max-w-7xl px-lg py-4xl grid grid-cols-2 md:grid-cols-4 gap-xl text-body-sm text-body">
        <div>
          <div class="eyebrow mb-sm uppercase">Calculators</div>
          <ul class="space-y-xs">
            <li><a class="hover:text-ink" href="/calculator">Beam calculator</a></li>
            <li><a class="hover:text-ink" href="/calculator/simply-supported-beam-calculator">Simply supported beams</a></li>
            <li><a class="hover:text-ink" href="/calculator/cantilever-beam-calculator">Cantilever beams</a></li>
            <li><a class="hover:text-ink" href="/calculator/continuous-two-span">Continuous beams</a></li>
          </ul>
        </div>
        <div>
          <div class="eyebrow mb-sm uppercase">Materials</div>
          <ul class="space-y-xs">
            <li><a class="hover:text-ink" href="/calculator/steel-beam-calculator">Steel beams</a></li>
            <li><a class="hover:text-ink" href="/calculator/wood-beam-calculator">Wood beams</a></li>
            <li><a class="hover:text-ink" href="/calculator/ridge-beam-calculator">Ridge beams</a></li>
            <li><a class="hover:text-ink" href="/calculator/overhanging-beam">Overhanging beams</a></li>
          </ul>
        </div>
        <div>
          <div class="eyebrow mb-sm uppercase">Learn</div>
          <ul class="space-y-xs">
            <li><a class="hover:text-ink" href="/formulas">Beam formulas</a></li>
            <li><a class="hover:text-ink" href="/guide">Reading SFD & BMD</a></li>
            <li><a class="hover:text-ink" href="/guide#sign-conventions">Sign conventions</a></li>
          </ul>
        </div>
        <div>
          <div class="eyebrow mb-sm uppercase">Resources</div>
          <ul class="space-y-xs">
            <li><a class="hover:text-ink" href="/calculator/fixed-fixed-udl">Fixed–fixed beam</a></li>
            <li><a class="hover:text-ink" href="/calculator/overhanging-beam">Overhanging beam</a></li>
            <li><a class="hover:text-ink" href="/about">About</a></li>
            <li><a class="hover:text-ink" href="/contact">Contact us</a></li>
            <li><a class="hover:text-ink" href="/privacy">Privacy policy</a></li>
            <li><a class="hover:text-ink" href="/terms">Terms &amp; conditions</a></li>
          </ul>
        </div>
        <div>
          <div class="eyebrow mb-sm uppercase">OnlineBeamCalculator.com</div>
          <p class="text-caption text-mute max-w-[28ch]">Free structural beam analysis in your browser. No account, no limits, no install.</p>
        </div>
      </div>
      <div class="border-t border-hairline">
        <div class="mx-auto max-w-7xl px-lg py-md flex items-center justify-between text-caption text-mute">
          <span>© {new Date().getFullYear()} OnlineBeamCalculator.com</span>
          <span class="flex items-center gap-sm">
            <a class="hover:text-ink" href="/privacy">Privacy</a>
            <a class="hover:text-ink" href="/terms">Terms</a>
            <a class="hover:text-ink" href="/contact">Contact</a>
          </span>
          <span class="font-mono">Runs 100% client-side</span>
        </div>
      </div>
    </footer>
  </body>
</html>
