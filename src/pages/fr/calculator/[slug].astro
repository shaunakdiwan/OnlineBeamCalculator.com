---
import Layout from '../../../layouts/Layout.astro';
import CalculatorPage from '../../../components/pages/CalculatorPage.astro';
import { fr } from '../../../i18n/fr';
import { PRESETS, VARIANT_LANDINGS } from '../../../lib/ui/presets';
import { PRESET_SLUGS, VARIANT_SLUGS } from '../../../i18n/types';
import type { CalculatorSlug } from '../../../i18n/types';

export async function getStaticPaths() {
  const allSlugs: CalculatorSlug[] = [...PRESET_SLUGS, ...VARIANT_SLUGS];
  return allSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const pageSlug = slug as CalculatorSlug;

const presetsList = PRESETS.map((p) => ({ slug: p.slug, name: p.name }));
const variantLandingsList = VARIANT_LANDINGS.map((v) => ({ slug: v.slug, h1: v.h1 }));

const metaTitle = pageSlug in fr.calculators.presets
  ? fr.calculators.presets[pageSlug as keyof typeof fr.calculators.presets].name + fr.calculators.ui.presetTitleSuffix
  : fr.calculators.variants[pageSlug as keyof typeof fr.calculators.variants].title;

const metaDescription = pageSlug in fr.calculators.presets
  ? fr.calculators.presets[pageSlug as keyof typeof fr.calculators.presets].description + fr.calculators.ui.presetDescSuffix
  : fr.calculators.variants[pageSlug as keyof typeof fr.calculators.variants].description;
---

<Layout locale="fr" title={metaTitle} description={metaDescription}>
  <CalculatorPage
    locale="fr"
    pageSlug={pageSlug}
    copy={fr.calculators}
    presetsList={presetsList}
    variantLandingsList={variantLandingsList}
  />
</Layout>
