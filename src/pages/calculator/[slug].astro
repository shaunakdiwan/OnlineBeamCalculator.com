---
import Layout from '../../layouts/Layout.astro';
import CalculatorPage from '../../components/pages/CalculatorPage.astro';
import { en } from '../../i18n/en';
import { PRESETS, VARIANT_LANDINGS } from '../../lib/ui/presets';
import { PRESET_SLUGS, VARIANT_SLUGS, CalculatorSlug } from '../../i18n/types';

export async function getStaticPaths() {
  const allSlugs: CalculatorSlug[] = [...PRESET_SLUGS, ...VARIANT_SLUGS];
  return allSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const pageSlug = slug as CalculatorSlug;

const presetsList = PRESETS.map((p) => ({ slug: p.slug, name: p.name }));
const variantLandingsList = VARIANT_LANDINGS.map((v) => ({ slug: v.slug, h1: v.h1 }));

const metaTitle = pageSlug in en.calculators.presets
  ? en.calculators.presets[pageSlug as keyof typeof en.calculators.presets].name + en.calculators.ui.presetTitleSuffix
  : en.calculators.variants[pageSlug as keyof typeof en.calculators.variants].title;

const metaDescription = pageSlug in en.calculators.presets
  ? en.calculators.presets[pageSlug as keyof typeof en.calculators.presets].description + en.calculators.ui.presetDescSuffix
  : en.calculators.variants[pageSlug as keyof typeof en.calculators.variants].description;
---

<Layout locale="en" title={metaTitle} description={metaDescription}>
  <CalculatorPage
    locale="en"
    pageSlug={pageSlug}
    copy={en.calculators}
    presetsList={presetsList}
    variantLandingsList={variantLandingsList}
  />
</Layout>