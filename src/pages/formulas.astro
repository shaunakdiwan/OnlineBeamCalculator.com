---
import Layout from '../layouts/Layout.astro';
import katex from 'katex';
import 'katex/dist/katex.min.css';

const k = (tex: string) => katex.renderToString(tex, { throwOnError: false, displayMode: false });

// Each row: name, description, and TeX for reactions / Mmax / δmax.
const cases: { name: string; sketch: string; reactions: string; Mmax: string; dmax: string }[] = [
  {
    name: 'Simply supported, center point load P',
    sketch: 'Pin A, roller B; P at x = L/2',
    reactions: 'R_A = R_B = \\frac{P}{2}',
    Mmax: 'M_{max} = \\frac{PL}{4}\\ \\text{at } x = L/2',
    dmax: '\\delta_{max} = \\frac{PL^3}{48\\,EI}',
  },
  {
    name: 'Simply supported, point load P at x = a',
    sketch: 'Pin A, roller B; P at distance a from A (b = L − a)',
    reactions: 'R_A = \\frac{P\\,b}{L}, \\quad R_B = \\frac{P\\,a}{L}',
    Mmax: 'M_{max} = \\frac{P a b}{L}\\ \\text{at } x = a',
    dmax: '\\delta_{max} = \\frac{P a b \\,(L^2 - a^2 - b^2)^{3/2}}{9\\sqrt{3}\\,EIL}',
  },
  {
    name: 'Simply supported, UDL w (whole span)',
    sketch: 'Pin A, roller B, uniform w',
    reactions: 'R_A = R_B = \\frac{wL}{2}',
    Mmax: 'M_{max} = \\frac{wL^2}{8}\\ \\text{at midspan}',
    dmax: '\\delta_{max} = \\frac{5\\,wL^4}{384\\,EI}',
  },
  {
    name: 'Simply supported, applied moment M₀ at x = a',
    sketch: 'Concentrated couple',
    reactions: 'R_A = -\\frac{M_0}{L}, \\quad R_B = +\\frac{M_0}{L}',
    Mmax: '\\text{M jumps by } M_0 \\text{ at } x = a',
    dmax: '\\text{(piecewise linear, no closed form)}',
  },
  {
    name: 'Cantilever, tip point load P',
    sketch: 'Fixed at A; P at free tip',
    reactions: 'R_A = P, \\quad M_A = -P\\,L',
    Mmax: '|M|_{max} = P\\,L\\ \\text{at fixed end}',
    dmax: '\\delta_{tip} = \\frac{P L^3}{3\\,EI}',
  },
  {
    name: 'Cantilever, UDL w (whole length)',
    sketch: 'Fixed at A, uniform w',
    reactions: 'R_A = wL, \\quad M_A = -\\frac{wL^2}{2}',
    Mmax: '|M|_{max} = \\frac{wL^2}{2}\\ \\text{at fixed end}',
    dmax: '\\delta_{tip} = \\frac{wL^4}{8\\,EI}',
  },
  {
    name: 'Cantilever, triangular load (0 at tip → w at wall)',
    sketch: 'Linearly increasing toward the wall',
    reactions: 'R_A = \\frac{wL}{2}, \\quad M_A = -\\frac{wL^2}{6}',
    Mmax: '|M|_{max} = \\frac{wL^2}{6}\\ \\text{at wall}',
    dmax: '\\delta_{tip} = \\frac{wL^4}{30\\,EI}',
  },
  {
    name: 'Propped cantilever, UDL w',
    sketch: 'Fixed at A, roller at B',
    reactions: 'R_B = \\frac{3\\,wL}{8}, \\quad R_A = \\frac{5\\,wL}{8}, \\quad M_A = -\\frac{wL^2}{8}',
    Mmax: 'M_+ = \\frac{9\\,wL^2}{128}\\ \\text{at } x = \\tfrac{5L}{8}',
    dmax: '\\delta_{max} \\approx 0.00541\\,\\frac{wL^4}{EI}\\ \\text{at } x \\approx 0.5785\\,L',
  },
  {
    name: 'Fixed–fixed, UDL w',
    sketch: 'Both ends fixed',
    reactions: 'R_A = R_B = \\frac{wL}{2}, \\quad M_A = M_B = -\\frac{wL^2}{12}',
    Mmax: 'M_+ = \\frac{wL^2}{24}\\ \\text{at midspan}',
    dmax: '\\delta_{max} = \\frac{wL^4}{384\\,EI}',
  },
  {
    name: 'Fixed–fixed, center point P',
    sketch: 'Both ends fixed; P at L/2',
    reactions: 'R_A = R_B = \\frac{P}{2}, \\quad M_A = M_B = -\\frac{P\\,L}{8}',
    Mmax: 'M_+ = \\frac{P\\,L}{8}\\ \\text{at midspan}',
    dmax: '\\delta_{max} = \\frac{P\\,L^3}{192\\,EI}',
  },
  {
    name: 'Two equal spans, UDL w on both',
    sketch: 'Pins at A, B, C; each span L',
    reactions: 'R_A = R_C = \\frac{3\\,wL}{8}, \\quad R_B = \\frac{10\\,wL}{8}',
    Mmax: 'M_- = \\frac{wL^2}{8}\\ \\text{over B;} \\quad M_+ = \\frac{9\\,wL^2}{128}',
    dmax: '\\delta \\approx 0.0052\\,\\frac{wL^4}{EI}\\ \\text{per span}',
  },
  {
    name: 'Overhanging (symmetric), UDL w',
    sketch: 'Supports at distance a from each end, total length L',
    reactions: 'R_A = R_B = \\frac{wL}{2}',
    Mmax: 'M_{\\text{supports}} = -\\frac{w\\,a^2}{2}',
    dmax: '\\text{depends on } a/L',
  },
];
---

<Layout
  title="Beam Formulas | Reactions, Moments & Deflections"
  description="Closed-form beam formulas: reactions, maximum moment and deflection for simply supported, cantilever, fixed–fixed and continuous beams."
>>
  <div class="mx-auto max-w-7xl px-lg py-xl">
    <div class="eyebrow uppercase mb-xxs">Reference</div>
    <h1 class="text-display-lg font-semibold">Beam formulas</h1>
    <p class="mt-sm text-body-md text-body max-w-[48rem]">
      Closed-form reactions, maximum moments and maximum deflections for the standard beam cases.
      Every case below can be loaded interactively in the
      <a class="text-link hover:underline" href="/calculator">calculator</a>.
    </p>

    <div class="mt-xl grid gap-lg">
      {cases.map((c) => (
        <article class="card p-md">
          <div class="mb-sm">
            <h2 class="text-display-sm font-semibold">{c.name}</h2>
            <p class="text-body-sm text-body mt-xxs">{c.sketch}</p>
          </div>
          <div class="grid md:grid-cols-3 gap-md">
            <div>
              <div class="eyebrow uppercase mb-xxs">Reactions</div>
              <div class="katex-wrap" set:html={k(c.reactions)}></div>
            </div>
            <div>
              <div class="eyebrow uppercase mb-xxs">Bending moment</div>
              <div class="katex-wrap" set:html={k(c.Mmax)}></div>
            </div>
            <div>
              <div class="eyebrow uppercase mb-xxs">Deflection</div>
              <div class="katex-wrap" set:html={k(c.dmax)}></div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-2xl max-w-[48rem] text-body-sm text-body">
      <h2 class="text-display-sm font-semibold text-ink">Check a formula live</h2>
      <p class="mt-xs">
        Every closed-form answer above has a matching interactive case. Verify the numbers yourself:
        <a class="text-link hover:underline" href="/calculator/cantilever-udl">cantilever under uniform load</a>,
        <a class="text-link hover:underline" href="/calculator/cantilever-tip-load">cantilever with tip load</a>,
        <a class="text-link hover:underline" href="/calculator/simply-supported-udl">simply supported with UDL</a>,
        <a class="text-link hover:underline" href="/calculator/fixed-fixed-udl">fixed–fixed with UDL</a>, or the
        <a class="text-link hover:underline" href="/calculator/continuous-two-span">two-span continuous beam</a>.
        The full directory is on the <a class="text-link hover:underline" href="/calculator">calculators page</a>.
      </p>
    </div>

    <p class="mt-lg text-caption text-mute max-w-[48rem]">
      P point load · w distributed load per unit length · L span · E Young's modulus · I second moment of area.
      Sagging moments positive; downward deflections positive-plotted.
    </p>
  </div>
</Layout>

<style is:global>
  .katex-wrap .katex { font-size: 1.05em; }
  .katex-wrap .katex-display { margin: 0.25em 0; }
</style>
