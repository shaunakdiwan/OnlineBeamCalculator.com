---
/**
 * Shared ContactPage component — renders the contact page for any locale.
 */

import type { ContactCopy } from '../../i18n/types';

interface Props {
  locale: string;
  copy: ContactCopy;
}

const { locale, copy } = Astro.props;
---

<div class="mx-auto max-w-[48rem] px-lg py-xl">
  <div class="eyebrow uppercase mb-xxs">{copy.eyebrow}</div>
  <h1 class="text-display-lg font-semibold">{copy.h1}</h1>
  <div class="mt-lg space-y-md text-body-md text-body">
    <p>{copy.intro}</p>

    <h2 class="text-display-sm font-semibold text-ink">{copy.emailH2}</h2>
    <p set:html={copy.emailP} />

    <h2 class="text-display-sm font-semibold text-ink">{copy.reportH2}</h2>
    <p>{copy.reportIntro}</p>
    <ul class="list-disc pl-md space-y-xxs">
      {copy.reportItems.map((item, i) => (
        <li key={i}>{item}</li>
      ))}
    </ul>
    <p>{copy.reportOutro}</p>

    <h2 class="text-display-sm font-semibold text-ink">{copy.featureH2}</h2>
    <p>{copy.featureP}</p>
  </div>
</div>