---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Online Beam Calculator | Free Shear, Moment & Deflection Tool"
  description="The free beam calculator online: analyze simply supported, cantilever, fixed, overhanging and continuous beams with instant SFD, BMD, slope and deflection diagrams. No signup."
  keywords={['online beam calculator', 'beam calculator online', 'free beam calculator', 'beam calculator free']}
>
  <div class="mx-auto max-w-7xl px-md sm:px-lg py-lg">
    <div id="beam-app" class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-lg">
      <aside id="input-panel" class="card p-md min-w-0 overflow-x-auto"></aside>
      <section class="flex flex-col gap-lg min-w-0">
        <div id="beam-canvas-wrap" class="card p-md overflow-x-auto"></div>
        <div id="results-dashboard"></div>
        <div id="diagrams" class="flex flex-col gap-lg"></div>
      </section>
    </div>
  </div>
  <script>
    import { initBeamApp } from '../../lib/ui/app';
    initBeamApp();
  </script>
</Layout>
