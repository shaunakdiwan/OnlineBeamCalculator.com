---
import Layout from '../../../layouts/Layout.astro';
import CalculatorPage from '../../../components/pages/CalculatorPage.astro';
import { ru } from '../../../i18n/ru';
import { PRESETS, VARIANT_LANDINGS } from '../../../lib/ui/presets';
import { PRESET_SLUGS, VARIANT_SLUGS } from '../../../i18n/types';
import type { CalculatorSlug } from '../../../i18n/types';

export async function getStaticPaths() {
  const allSlugs: CalculatorSlug[] = [...PRESET_SLUGS, ...VARIANT_SLUGS];
  return allSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const pageSlug = slug as CalculatorSlug;

const presetsList = PRESETS.map((p) => ({ slug: p.slug, name: p.name }));
const variantLandingsList = VARIANT_LANDINGS.map((v) => ({ slug: v.slug, h1: v.h1 }));

const metaTitle = pageSlug in ru.calculators.presets
  ? ru.calculators.presets[pageSlug as keyof typeof ru.calculators.presets].name + ru.calculators.ui.presetTitleSuffix
  : ru.calculators.variants[pageSlug as keyof typeof ru.calculators.variants].title;

const metaDescription = pageSlug in ru.calculators.presets
  ? ru.calculators.presets[pageSlug as keyof typeof ru.calculators.presets].description + ru.calculators.ui.presetDescSuffix
  : ru.calculators.variants[pageSlug as keyof typeof ru.calculators.variants].description;
---

<Layout locale="ru" title={metaTitle} description={metaDescription}>
  <CalculatorPage
    locale="ru"
    pageSlug={pageSlug}
    copy={ru.calculators}
    presetsList={presetsList}
    variantLandingsList={variantLandingsList}
  />
</Layout>
