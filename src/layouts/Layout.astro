---
import '../styles/global.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { getLocaleFromPath, PUBLISHED_LOCALES, OG_LOCALE_MAP, HREFLANG_MAP, DEFAULT_LOCALE, SITE } from '../i18n/config';
import type { Locale } from '../i18n/config';
import Hreflang from '../components/Hreflang.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { en } from '../i18n/en';
import { es } from '../i18n/es';
import { fr } from '../i18n/fr';
import { de } from '../i18n/de';
import { ru } from '../i18n/ru';
import type { LocaleCopy } from '../i18n/types';

const COPY_MAP: Record<string, LocaleCopy> = { en, es, fr, de, ru };

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  locale?: string;
}

const {
  title: explicitTitle,
  description: explicitDescription,
  canonical,
  ogImage,
  ogType = 'website',
  keywords: explicitKeywords,
  jsonLd,
  noindex = false,
  locale: explicitLocale,
} = Astro.props;

const locale = explicitLocale || getLocaleFromPath(Astro.url.pathname);
const copy = COPY_MAP[locale] || COPY_MAP[DEFAULT_LOCALE];
const { meta, chrome } = copy;
const isDefaultLocale = locale === DEFAULT_LOCALE;
const ogLocale = OG_LOCALE_MAP[locale as Locale] || OG_LOCALE_MAP[DEFAULT_LOCALE];
const siteName = 'OnlineBeamCalculator.com';

const title = explicitTitle ?? meta.defaultTitle;
const description = explicitDescription ?? meta.defaultDescription;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = path === '/' || path === `/${locale}`;
const canonicalUrl = canonical ?? new URL(path, SITE).href;
const ogImageUrl = ogImage ?? `${SITE}/og.png`;

const keywordsStr = (explicitKeywords ?? meta.defaultKeywords).join(', ');

const webAppLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      '@id': `${SITE}/#app`,
      name: siteName,
      alternateName: ['Beam Calculator', 'Free Beam Calculator', 'Online Beam Calculator'],
      url: SITE,
      applicationCategory: 'EngineeringApplication',
      applicationSubCategory: 'Structural Analysis',
      operatingSystem: 'Any',
      inLanguage: locale,
      isAccessibleForFree: true,
      featureList: [
        'Simply supported, cantilever, fixed, overhanging, and continuous beam analysis',
        'Shear force (SFD) and bending moment (BMD) diagrams',
        'Slope and deflection calculations',
        'Spring supports and internal hinges',
        'Point, moment, uniform, triangular and trapezoidal loads',
        'Self-weight and support settlement',
        'Metric and imperial units',
        'CSV export and printable PDF reports',
      ],
      description,
      audience: { '@type': 'Audience', audienceType: 'Engineers, students, builders' },
      provider: { '@type': 'Organization', name: siteName, url: SITE },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      '@id': `${SITE}/#app`,
      name: siteName,
      url: SITE,
      applicationCategory: 'EngineeringApplication',
      operatingSystem: 'Any',
      inLanguage: locale,
      isAccessibleForFree: true,
    };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordsStr} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="author" content={siteName} />
    <meta name="theme-color" content="#171717" />

    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L9C6S6PT5K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-L9C6S6PT5K');
    </script>

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8487839780771040"
      crossorigin="anonymous"></script>

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="OnlineBeamCalculator" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {PUBLISHED_LOCALES.filter(l => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE_MAP[l] || OG_LOCALE_MAP[DEFAULT_LOCALE]} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      // theme boot before first paint (avoid FOUC)
      try {
        const t = localStorage.getItem('obc:theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch {}
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppLd)} />
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Hreflang alternates (self + all published + x-default); skipped on noindex pages (404/500) which have no translated equivalents -->
    {!noindex && <Hreflang />}
  </head>
  <body class="min-h-screen flex flex-col bg-canvas-soft text-ink font-sans">
    <header class="sticky top-0 z-40 bg-canvas border-b border-hairline">
      <nav class="mx-auto max-w-7xl px-md sm:px-lg min-h-16 py-xs flex flex-wrap items-center justify-between gap-xs" aria-label="Main">
        <a href={locale === DEFAULT_LOCALE ? '/' : `/${locale}`} class="flex items-center gap-xs font-semibold tracking-tight text-body-sm sm:text-body-md">
          <img src="/Website_logo-circle.webp" alt="Online Beam Calculator Logo" width="28" height="28" class="h-7 w-7 rounded-full" />
          <span>OnlineBeamCalculator<span class="text-link">.com</span></span>
        </a>
        <div class="hidden md:flex items-center gap-xxs text-body-sm">
          <a class="px-sm py-xs rounded-full text-body hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator' : `/${locale}/calculator`}>{chrome.nav.calculator}</a>
          <a class="px-sm py-xs rounded-full text-body hover:text-ink" href={locale === DEFAULT_LOCALE ? '/formulas' : `/${locale}/formulas`}>{chrome.nav.formulas}</a>
          <a class="px-sm py-xs rounded-full text-body hover:text-ink" href={locale === DEFAULT_LOCALE ? '/guide' : `/${locale}/guide`}>{chrome.nav.guide}</a>
          <a class="px-sm py-xs rounded-full text-body hover:text-ink" href={locale === DEFAULT_LOCALE ? '/#faq' : `/${locale}/#faq`}>{chrome.nav.faq}</a>
          <a class="px-sm py-xs rounded-full text-body hover:text-ink" href={locale === DEFAULT_LOCALE ? '/about' : `/${locale}/about`}>{chrome.nav.about}</a>
        </div>
        <div class="flex items-center gap-xs sm:gap-sm">
          <button id="mobile-menu-toggle" class="md:hidden flex items-center justify-center p-[4px] text-body hover:text-ink rounded-sm border border-transparent hover:border-hairline" aria-label="Menu" aria-expanded="false">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          </button>
          <button id="theme-toggle-desktop" class="hidden md:block btn-secondary h-7 px-xs rounded-sm text-body-sm" aria-label={chrome.nav.toggleTheme} title={chrome.nav.toggleTheme}>◐</button>
          <span class="eyebrow hidden sm:inline border border-hairline rounded-full px-xs py-[2px] bg-canvas-soft">{chrome.nav.freeBadge}</span>
          <a href={locale === DEFAULT_LOCALE ? '/calculator' : `/${locale}/calculator`} class="btn-primary h-7 px-xs rounded-sm text-body-sm">{chrome.nav.openCalculator}</a>
          {!noindex && <LanguageSwitcher />}
          <button id="theme-toggle-mobile" class="md:hidden btn-secondary h-7 px-xs rounded-sm text-body-sm" aria-label={chrome.nav.toggleTheme} title={chrome.nav.toggleTheme}>◐</button>
        </div>
      </nav>
      <div id="mobile-menu" class="hidden md:hidden border-t border-hairline bg-canvas absolute w-full left-0 top-full shadow-md">
        <div class="flex flex-col py-sm px-md text-body-md">
          <a class="py-sm border-b border-hairline/50 text-body hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator' : `/${locale}/calculator`}>{chrome.nav.calculator}</a>
          <a class="py-sm border-b border-hairline/50 text-body hover:text-ink" href={locale === DEFAULT_LOCALE ? '/formulas' : `/${locale}/formulas`}>{chrome.nav.formulas}</a>
          <a class="py-sm border-b border-hairline/50 text-body hover:text-ink" href={locale === DEFAULT_LOCALE ? '/guide' : `/${locale}/guide`}>{chrome.nav.guide}</a>
          <a class="py-sm border-b border-hairline/50 text-body hover:text-ink" href={locale === DEFAULT_LOCALE ? '/#faq' : `/${locale}/#faq`}>{chrome.nav.faq}</a>
          <a class="py-sm text-body hover:text-ink" href={locale === DEFAULT_LOCALE ? '/about' : `/${locale}/about`}>{chrome.nav.about}</a>
        </div>
      </div>
      <script is:inline>
        (() => {
          const toggleTheme = () => {
            const dark = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('obc:theme', dark ? 'dark' : 'light'); } catch {}
            window.dispatchEvent(new CustomEvent('obc:theme', { detail: { dark } }));
          };
          document.getElementById('theme-toggle-desktop')?.addEventListener('click', toggleTheme);
          document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

          const mbToggle = document.getElementById('mobile-menu-toggle');
          const mbMenu = document.getElementById('mobile-menu');
          if (mbToggle && mbMenu) {
            const closeMenu = () => {
              mbMenu.classList.add('hidden');
              mbToggle.setAttribute('aria-expanded', 'false');
            };
            mbToggle.addEventListener('click', (e) => {
              e.stopPropagation();
              if (mbToggle.getAttribute('aria-expanded') === 'true') {
                closeMenu();
              } else {
                mbMenu.classList.remove('hidden');
                mbToggle.setAttribute('aria-expanded', 'true');
              }
            });
            document.addEventListener('click', (e) => {
              if (!mbMenu.contains(e.target) && !mbToggle.contains(e.target)) closeMenu();
            });
            mbMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
          }
        })();
      </script>
    </header>

    <main class="flex-1">
      <noscript>
        <div class="mx-auto max-w-[48rem] px-lg py-xl text-center">
          <p class="text-body-md text-body">{chrome.noscript}</p>
        </div>
      </noscript>
      <slot />
    </main>

    <footer class="bg-canvas border-t border-hairline mt-4xl">
      <div class="mx-auto max-w-7xl px-lg py-4xl grid grid-cols-2 md:grid-cols-4 gap-xl text-body-sm text-body">
        <div>
          <div class="eyebrow mb-sm uppercase">{chrome.footer.calculatorsHead}</div>
          <ul class="space-y-xs">
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator' : `/${locale}/calculator`}>{chrome.footer.linkBeamCalculator}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator/simply-supported-beam-calculator' : `/${locale}/calculator/simply-supported-beam-calculator`}>{chrome.footer.linkSimplySupported}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator/cantilever-beam-calculator' : `/${locale}/calculator/cantilever-beam-calculator`}>{chrome.footer.linkCantilever}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator/continuous-two-span' : `/${locale}/calculator/continuous-two-span`}>{chrome.footer.linkContinuous}</a></li>
          </ul>
        </div>
        <div>
          <div class="eyebrow mb-sm uppercase">{chrome.footer.materialsHead}</div>
          <ul class="space-y-xs">
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator/steel-beam-calculator' : `/${locale}/calculator/steel-beam-calculator`}>{chrome.footer.linkSteel}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator/wood-beam-calculator' : `/${locale}/calculator/wood-beam-calculator`}>{chrome.footer.linkWood}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator/ridge-beam-calculator' : `/${locale}/calculator/ridge-beam-calculator`}>{chrome.footer.linkRidge}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator/overhanging-beam' : `/${locale}/calculator/overhanging-beam`}>{chrome.footer.linkOverhanging}</a></li>
          </ul>
        </div>
        <div>
          <div class="eyebrow mb-sm uppercase">{chrome.footer.learnHead}</div>
          <ul class="space-y-xs">
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/formulas' : `/${locale}/formulas`}>{chrome.footer.linkFormulas}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/guide' : `/${locale}/guide`}>{chrome.footer.linkSfdBmd}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/guide#sign-conventions' : `/${locale}/guide#sign-conventions`}>{chrome.footer.linkSignConventions}</a></li>
          </ul>
        </div>
        <div>
          <div class="eyebrow mb-sm uppercase">{chrome.footer.resourcesHead}</div>
          <ul class="space-y-xs">
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator/fixed-fixed-udl' : `/${locale}/calculator/fixed-fixed-udl`}>{chrome.footer.linkFixedFixed}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/calculator/overhanging-beam' : `/${locale}/calculator/overhanging-beam`}>{chrome.footer.linkOverhanging}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/about' : `/${locale}/about`}>{chrome.footer.linkAbout}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/contact' : `/${locale}/contact`}>{chrome.footer.linkContactUs}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/privacy' : `/${locale}/privacy`}>{chrome.footer.linkPrivacyPolicy}</a></li>
            <li><a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/terms' : `/${locale}/terms`}>{chrome.footer.linkTerms}</a></li>
          </ul>
        </div>
        <div>
          <div class="eyebrow mb-sm uppercase">{chrome.footer.brandHead}</div>
          <p class="text-caption text-mute max-w-[28ch]">{chrome.footer.tagline}</p>
        </div>
      </div>
      <div class="border-t border-hairline">
        <div class="mx-auto max-w-7xl px-lg py-md flex flex-col md:flex-row items-center justify-between gap-y-md md:gap-y-0 text-center md:text-left text-caption text-mute">
          <span>© {new Date().getFullYear()} OnlineBeamCalculator.com</span>
          <span class="flex flex-wrap justify-center items-center gap-sm">
            <a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/privacy' : `/${locale}/privacy`}>{chrome.footer.bottomPrivacy}</a>
            <a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/terms' : `/${locale}/terms`}>{chrome.footer.bottomTerms}</a>
            <a class="hover:text-ink" href={locale === DEFAULT_LOCALE ? '/contact' : `/${locale}/contact`}>{chrome.footer.bottomContact}</a>
          </span>
          <span class="font-mono text-center">{chrome.footer.runsClientSide}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
